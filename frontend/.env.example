# Prism frontend — copy to .env.local and adjust. Every NEXT_PUBLIC_* value is
# shipped to the browser: never put secrets here.

# "mock" = in-browser mock server with fixture data (default in `next dev`)
# "http" = real backend (default in production builds)
NEXT_PUBLIC_API_MODE=mock

# Base URL of the FastAPI backend (REST). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: WebSocket origin if it differs from the API (defaults to the API
# origin with ws:// or wss://). The socket URL itself comes from
# POST /v1/realtime/tickets, so this is informational for most setups.
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Production builds refuse the mock adapter unless this is "true" (useful only
# for design-review previews; the UI shows a "Mock data" badge).
# NEXT_PUBLIC_ALLOW_MOCK_IN_PRODUCTION=false
