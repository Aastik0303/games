# Prism backend configuration. Copy to .env for local runs. Never commit real secrets.
# Every setting is PRISM_<NAME>; see app/config.py for types and defaults.

# development | test | production  (production refuses insecure settings at startup)
PRISM_ENV=development
PRISM_LOG_LEVEL=INFO

# Redis for all live state. "memory://" runs an in-process fake (dev only, ONE process, no persistence).
PRISM_REDIS_URL=redis://localhost:6379/0
# PRISM_REDIS_URL=memory://

# Durable records (profiles, consent, blocks, reports, audit, flags, catalog overrides).
# Local default is SQLite; use PostgreSQL anywhere shared:
#   postgresql+asyncpg://prism:CHANGE_ME@localhost:5432/prism
PRISM_DATABASE_URL=sqlite+aiosqlite:///./prism-dev.db
# true = create tables on startup (dev). Production: false, and run `alembic upgrade head`.
PRISM_DB_AUTO_CREATE=true

# Browser origins allowed to call the API with credentials (JSON list). Never "*".
PRISM_CORS_ORIGINS=["http://localhost:3000"]
# Session cookie. Must be true behind HTTPS (required in production).
PRISM_COOKIE_SECURE=false
# PRISM_COOKIE_DOMAIN=
# Public WebSocket origin handed to browsers in realtime tickets (wss:// in production).
PRISM_PUBLIC_WS_BASE_URL=ws://localhost:8000
# Only trust X-Forwarded-For when a known proxy sets it.
PRISM_TRUST_PROXY_HEADERS=false
# If set, GET /metrics requires "Authorization: Bearer <token>".
# PRISM_METRICS_TOKEN=

# Watch Together: https hosts allowed as shared video sources (JSON list).
PRISM_WATCH_ALLOWED_HOSTS=["upload.wikimedia.org","commons.wikimedia.org","archive.org","test-videos.co.uk"]

# Set false to run an API-only instance without the matcher / timers / sweeper.
PRISM_RUN_BACKGROUND_WORKERS=true
